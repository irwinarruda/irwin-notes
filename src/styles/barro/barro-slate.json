  "tokenColors": [
    {
      "name": "Comments and doc comments",
      "scope": [
        "comment",
        "comment.block.documentation entity.name.type",
        "comment.block.documentation variable",
        "comment.block.javadoc variable.parameter",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#979FA8"
      }
    },
    {
      "name": "Tags inside doc comments",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword",
        "comment.block.documentation storage.type.class",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#EC7D6B"
      }
    },
    {
      "name": "Keywords, storage, modifiers, control flow, imports",
      "scope": [
        "constant.language.import-export-all",
        "keyword",
        "storage",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#EC7D6B"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#EC7D6B"
      }
    },
    {
      "name": "Constructor calls",
      "scope": [
        "new.expr entity.name.function"
      ],
      "settings": {
        "foreground": "#EC7D6B"
      }
    },
    {
      "name": "String escapes and interpolation marks",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "constant.character.string.escape",
        "constant.other.placeholder",
        "punctuation.definition.interpolation",
        "punctuation.definition.template-expression",
        "punctuation.definition.variable.shell",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#EC7D6B"
      }
    },
    {
      "name": "Functions, methods, calls, decorators",
      "scope": [
        "entity.name.function",
        "meta.decorator variable.other",
        "meta.function-call.generic",
        "meta.function.decorator support.type",
        "punctuation.decorator",
        "punctuation.definition.annotation",
        "punctuation.definition.decorator",
        "source.lua support.function",
        "storage.type.annotation",
        "support.function.any-method",
        "support.function.console",
        "support.function.dom",
        "support.function.json",
        "support.function.math",
        "support.function.promise",
        "variable.function"
